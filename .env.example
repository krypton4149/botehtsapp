# ─────────────────────────────────────────────────────────
#  WhatsApp Business API Credentials
#  Get these from: https://developers.facebook.com
# ─────────────────────────────────────────────────────────

# Your WhatsApp Phone Number ID (from Meta Developer Dashboard)
PHONE_NUMBER_ID=your_phone_number_id_here

# Permanent Access Token (generate from Meta Business Suite)
ACCESS_TOKEN=your_access_token_here

# Optional — default v25.0 (must match your Graph calls in Meta dashboard)
# GRAPH_API_VERSION=v25.0

# This can be any secret word — you'll enter it in Meta webhook settings
VERIFY_TOKEN=restaurant_bot_2024

# Webhook must be PUBLIC HTTPS (e.g. Railway URL) with path /webhook
# Meta → WhatsApp → Configuration → Webhook → Callback URL: https://YOUR_HOST/webhook
# Subscribe to field: messages. VERIFY_TOKEN must match VERIFY_TOKEN above.
# After deploy, open https://YOUR_HOST/health/whatsapp — graphOk should be true.

# Port (Railway/Render sets this automatically)
PORT=3000

# ─────────────────────────────────────────────────────────
#  Supabase — https://supabase.com/dashboard → Project Settings → API
#  Publishable key is safe for browser; use service_role only on the server.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Optional server-only aliases (Vercel/Railway): same URL/key as above — avoids exposing NEXT_PUBLIC_* if you prefer.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here

# Server-only: Project Settings → API → service_role (bypasses RLS). Never expose to the browser.
# Strongly recommended: WhatsApp checkout + dashboard order list/insert need this if RLS blocks the anon key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# Optional: direct Postgres URI (Database → Connection string → URI, host db.*.supabase.co port 5432).
# If set, the server can auto-create the orders.out_for_delivery column when you use the Delivery toggle.
# SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxx.supabase.co:5432/postgres
