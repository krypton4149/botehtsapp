# ─────────────────────────────────────────────────────────
#  WhatsApp Business API Credentials
#  Get these from: https://developers.facebook.com
# ─────────────────────────────────────────────────────────

# Your WhatsApp Phone Number ID (from Meta Developer Dashboard)
PHONE_NUMBER_ID=your_phone_number_id_here

# Permanent Access Token (generate from Meta Business Suite)
ACCESS_TOKEN=your_access_token_here

# This can be any secret word — you'll enter it in Meta webhook settings
VERIFY_TOKEN=restaurant_bot_2024

# Port (Railway/Render sets this automatically)
PORT=3000

# ─────────────────────────────────────────────────────────
#  Supabase — https://supabase.com/dashboard → Project Settings → API
#  Publishable key is safe for browser; use service_role only on the server.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-only: Project Settings → API → service_role (bypasses RLS). Never expose to the browser.
# Strongly recommended: WhatsApp checkout + dashboard order list/insert need this if RLS blocks the anon key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here
