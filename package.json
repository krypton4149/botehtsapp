{
  "name": "restaurant-whatsapp-meta-bot",
  "version": "1.0.0",
  "description": "Restaurant WhatsApp Bot using Meta Business Cloud API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clear-menu-db": "node scripts/clear-menu-db.js",
    "build-menu-seed": "node -e \"require('fs').writeFileSync('supabase/seed.sql', require('./scripts/menu-seed-data').buildSeedSql())\"",
    "apply-menu-seed": "node scripts/apply-menu-seed.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
